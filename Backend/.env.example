# Hospedagem: substitua as URLs pelos endereços públicos após os deploys.
NODE_ENV=production
FRONTEND_URL=https://URL-DO-SEU-FRONTEND
PUBLIC_API_URL=https://URL-DO-SEU-BACKEND

## Set DATABASE_URL or the separate DB_* values. DATABASE_URL takes precedence.
DATABASE_URL=
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_HOST=redecamarao-elalerrandroads-6136.l.aivencloud.com
DB_PORT=13054
DB_SSL_MODE=require
# Download the project CA from Aiven to enable certificate verification.
# DB_SSL_CA_PATH=database/certs/ca.pem
# DB_SSL_MODE=verify-full
DB_POOL_MAX=5
# Se a hospedagem definir PORT automaticamente, use o valor fornecido por ela.
PORT=3001
RATE_LIMIT_STORE=postgres

# Used by both admin and user authentication. Set distinct, strong secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Opcional: recuperação de senha de administradores via Resend.
RESEND_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_FRONTEND_URL=https://URL-DO-SEU-FRONTEND
